{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // MUST match the existing Worker in the Cloudflare dashboard that
  // clientgather.com is routed to. A different name deploys a second, separate
  // Worker and leaves the live domain on the broken build.
  "name": "swifty-doc-landing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  // Required by the adapter; the compatibility date must be 2024-09-23 or later.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
